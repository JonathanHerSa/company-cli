# Entorno __ENV__ de __PROJECT_NAME__ para `cloudrun-kit` (sin secretos). EDITA todo lo que diga CAMBIAME antes de usarlo:
# `cloudrun-kit bootstrap` se niega a ejecutarse mientras quede alguno.
#   cloudrun-kit bootstrap deploy/__ENV__.env --dry-run     # ver qué haría (solo lee)
#   cloudrun-kit bootstrap deploy/__ENV__.env               # crearlo todo en Google Cloud
# Para otro entorno: cloudrun-kit env new production --app __PROJECT__     Guía: `cloudrun-kit guide`

APP=__PROJECT__
ENV_NAME=__ENV__
PROJECT_ID=__GCP_PROJECT__
REGION=__GCP_REGION__
SECRET_PREFIX=__PROJECT__
GITHUB_OWNER=__GITHUB_ORG__
BRANCH=__BRANCH__

# ── Componentes: cada uno = un repo + un servicio de Cloud Run ───────────────────────────────
COMPONENTS=(__COMPONENTS__)

# @if back
back_REPO=__PROJECT___back
back_SA=api
back_DOMAIN=
back_HEALTH=/__API_PREFIX__/health
back_SECRETS=yes
# @if hasCloudSql
back_ROLES="roles/cloudsql.client"
# @endif
# @if mobile
back_FCM=yes
# @endif
back_IGNORED='**/*.md,docs/**'
# Sustituciones del cloudbuild.yaml del Back (separadas por `|`). `_ENV_VARS` = variables normales separadas por `#`.
back_SUBS='__BACK_SUBS__'
# @endif

# @if front
front_REPO=__PROJECT___front
front_SA=web
front_DOMAIN=
front_HEALTH=__FRONT_HEALTH__
front_SUBS='__FRONT_SUBS__'
# @endif

# ── Secretos: "sufijo|VARIABLE|origen"  (prompt = se pide; b64 / hex32 = se genera al azar) ────
SECRETS=(
# @if back
# @if hasDb
  "db-password|DB_PASSWORD|prompt"
# @endif
  "jwt-secret|JWT_SECRET|b64"
  "jwt-refresh-secret|JWT_REFRESH_SECRET|b64"
  "mfa-encryption-key|MFA_ENCRYPTION_KEY|hex32"
  "pusher-secret|PUSHER_SECRET|prompt"
  "redis-password|REDIS_PASSWORD|prompt"
# @endif
)

# ── Recursos (vacío = se omiten) ─────────────────────────────────────────────────────────────
# @if hasCloudSql
CLOUDSQL_INSTANCE=CAMBIAME-instancia-cloud-sql     # instancia existente (no la crea)
DB_NAME=__DB_STAGE_NAME__
DB_USER=__DB_STAGE_NAME__
DB_PASSWORD_SECRET=db-password
# @endif
GCS_BUCKET=                                        # bucket PRIVADO para archivos (URLs firmadas); lo crea si no existe
# @if mobile
FIREBASE_PROJECT_ID=                               # proyecto de Firebase para push (FCM)
# Con FIREBASE_PROJECT_ID definido, el paso `firebase-app` crea (o reutiliza) la app Android en Firebase y descarga
# google-services.json a Mobile/android/app/. iOS (opcional): FIREBASE_IOS_BUNDLE=com.mi.bundle (la llave APNs sigue siendo manual).
FIREBASE_ANDROID_PACKAGE=__ANDROID_PACKAGE__
# FIREBASE_IOS_BUNDLE=
# @endif

# ── Despertador: solo si el Back escala a cero y tiene jobs internos (BullMQ) ─────────────────
WAKE_SCHEDULE=
WAKE_COMPONENT=back
WAKE_PATH=/__API_PREFIX__/health
TZ_NAME=__TZ__

# ── Automatización opcional ──────────────────────────────────────────────────────────────────
# @if hasCloudSql
# Crear la instancia de Cloud SQL si no existe (tarda ~10 min y genera COSTO CONTINUO); la contraseña root se guarda como secreto.
# CLOUDSQL_CREATE=yes
# CLOUDSQL_TIER=db-f1-micro
# CLOUDSQL_VERSION=MYSQL_8_0
# CLOUDSQL_STORAGE_GB=10
# @endif
# DNS: ningún proveedor común (Squarespace, GoDaddy...) tiene API. El paso `dns` muestra el registro EXACTO que debes crear y comprueba la
# propagación (DNS_WAIT_MINUTES=10 espera hasta que resuelva). DNS_ZONE = dominio base, para mostrar el host relativo.
DNS_PROVIDER=manual
DNS_ZONE=
# DNS_WAIT_MINUTES=0
